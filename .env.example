# ============================================
# ZARIYA by IQRA — Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# For Hostinger Premium hosting, use your domain's database

# --- DATABASE ---
# For SQLite (development/local):
DATABASE_URL="file:./db/custom.db"
# For MySQL (Hostinger Premium — recommended):
# DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/zariya_db"

# --- ADMIN AUTH ---
# Change this to a random string (use: openssl rand -hex 32)
ADMIN_SECRET="change-this-to-a-random-secret-string"

# --- NEXTAUTH (Google Login) ---
NEXTAUTH_SECRET="change-this-to-a-random-string"
NEXTAUTH_URL="https://yourdomain.com"

# --- GOOGLE OAUTH (for customer login) ---
# Get from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# --- RAZORPAY (Online Payments) ---
# Get from: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID="rzp_test_yourkey"
RAZORPAY_KEY_SECRET="your-razorpay-secret"

# --- SMTP EMAIL (for email automation) ---
# Use Hostinger's SMTP or Gmail/SendGrid
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT="465"
SMTP_USER="noreply@yourdomain.com"
SMTP_PASS="your-email-password"
SMTP_FROM="ZARIYA by IQRA <noreply@yourdomain.com>"

# --- WHATSAPP (optional — for WhatsApp Business API) ---
WHATSAPP_PHONE="919876543210"
